<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".KookboekApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kookboek">

        <!--
          No launcher intent-filter here on purpose: that lives on the aliases below, so
          the icon on the home screen can follow the chosen palette.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Kookboek" />

        <!--
          The aliases point here and not at MainActivity, so that the task you end up in is
          rooted at MainActivity. Disabling an alias takes its tasks with it, and that would
          otherwise be your own session. See LauncherRouter.

          taskAffinity="" gives this its own throwaway task; excludeFromRecents keeps that
          task out of the overview; noHistory makes sure nothing of it is left behind.
        -->
        <activity
            android:name=".LauncherRouter"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Kookboek" />

        <!--
          One alias per palette, each with its own icon, and exactly one enabled at a
          time. LauncherIcon.kt does the switching; KookboekApp keeps it in step with the
          stored choice.

          Sinaasappel is the one enabled here because it is the default palette. Every
          alias must stay declared: PaletteId maps onto these names, and a missing one
          means the app has no icon at all. LauncherIconTest checks that.
        -->
        <activity-alias
            android:name=".LauncherSinaasappel"
            android:targetActivity=".LauncherRouter"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sinaasappel"
            android:roundIcon="@mipmap/ic_launcher_sinaasappel"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherOlijf"
            android:targetActivity=".LauncherRouter"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_olijf"
            android:roundIcon="@mipmap/ic_launcher_olijf"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBosbes"
            android:targetActivity=".LauncherRouter"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bosbes"
            android:roundIcon="@mipmap/ic_launcher_bosbes"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherRabarber"
            android:targetActivity=".LauncherRouter"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rabarber"
            android:roundIcon="@mipmap/ic_launcher_rabarber"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherEspresso"
            android:targetActivity=".LauncherRouter"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_espresso"
            android:roundIcon="@mipmap/ic_launcher_espresso"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherInkt"
            android:targetActivity=".LauncherRouter"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_inkt"
            android:roundIcon="@mipmap/ic_launcher_inkt"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          Browser > Share > Kookboek.
          Only text/plain: that is what browsers send for "share this page", and it
          keeps Kookboek out of every unrelated chooser on the phone.
        -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:theme="@style/Theme.Kookboek.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>

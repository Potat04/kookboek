<?xml version="1.0" encoding="utf-8"?>
<!--
  Tells Android which languages Kookboek is written in, so the per-app language
  picker in the phone's own settings offers them. The app's own settings screen
  writes the same value through LocaleManager.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="nl" />
    <locale android:name="en" />
</locale-config>

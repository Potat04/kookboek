<?xml version="1.0" encoding="utf-8"?>
<!-- The round variant of the default icon. Adaptive icons are masked by the launcher
     anyway, so this only differs from ic_launcher.xml in which attribute points at it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_sinaasappel" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

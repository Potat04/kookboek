<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon for the "espresso" palette. One of six; the manifest has an
  activity-alias per palette and KookboekApp enables the one that matches the choice.
  Only the background colour differs between them.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_espresso" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The heart for the "Favourites" shortcut, centred on the 108dp adaptive canvas.
  The glyph is drawn on a 24 grid and scaled 2x, so it spans 48dp of the 72dp the
  launcher shows: ink on paper, with room around it for the mask.

  Ink and paper rather than the palette accent. A shortcut icon is one static image and
  cannot follow the six palettes the way the app icon does through its aliases, and a
  fixed accent beside a launcher icon in another colour reads as a mistake.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="2"
        android:scaleY="2"
        android:translateX="30"
        android:translateY="30">
        <path
            android:fillColor="#FF211D18"
            android:pathData="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 Z" />
    </group>
</vector>
